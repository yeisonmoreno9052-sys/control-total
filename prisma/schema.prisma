// Esquema de Control Total.
// Jerarquía: Empresa → Negocio → todo lo demás.
// Toda tabla de negocio lleva empresaId (y negocioId cuando aplica).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMINISTRADOR
  SOCIO
  CAJERO
  SUPERADMIN
}

enum EstadoSuscripcion {
  ACTIVA
  SUSPENDIDA
}

enum Modulo {
  INVENTARIO
  VENTAS
  PROVEEDORES
  CAJA
  REPORTES
}

/// Cliente de EMY TELECOM (ej. "Camila").
model Empresa {
  id                String            @id @default(cuid())
  nombre            String
  nit               String?
  telefono          String?
  correo            String?
  direccion         String?
  logoUrl           String?
  /// Logo de la empresa (encabezado y recibos). Se guarda en la base porque el servidor no conserva archivos.
  logo              Bytes?
  logoTipo          String?
  estadoSuscripcion EstadoSuscripcion @default(ACTIVA)
  modulosActivos    Modulo[]          @default([INVENTARIO, VENTAS, PROVEEDORES, CAJA, REPORTES])
  activo            Boolean           @default(true)
  creadoEn          DateTime          @default(now())
  actualizadoEn     DateTime          @updatedAt

  negocios           Negocio[]
  usuarios           Usuario[]
  usuarioNegocios    UsuarioNegocio[]
  categorias         Categoria[]
  productos          Producto[]
  movimientos        MovimientoInventario[]
  auditorias         Auditoria[]
  clientes           Cliente[]
  cajas              Caja[]
  ventas             Venta[]
  detalleVentas      DetalleVenta[]
  pagoVentas         PagoVenta[]
  devolucions        Devolucion[]
  detalleDevolucions DetalleDevolucion[]
}

/// Cada local dentro de la empresa (ej. "Repuestos de moto", "Ferretería").
model Negocio {
  id                    String   @id @default(cuid())
  empresaId             String
  nombre                String
  direccion             String?
  tipo                  String?
  // Datos fiscales, preparados para facturación electrónica (DIAN).
  nit                   String?
  razonSocial           String?
  regimen               String?
  telefono              String?
  /// Texto al pie del recibo ("Gracias por su compra").
  mensajeRecibo         String?
  /// Último consecutivo usado. Se incrementa dentro de la misma transacción de la venta.
  consecutivoVenta      Int      @default(0)
  consecutivoDevolucion Int      @default(0)
  /// Margen sugerido por defecto, en % sobre el costo. Las categorías pueden tener el suyo.
  margenSugerido        Decimal  @default(30) @db.Decimal(6, 2)
  activo                Boolean  @default(true)
  creadoEn              DateTime @default(now())
  actualizadoEn         DateTime @updatedAt

  empresa            Empresa                @relation(fields: [empresaId], references: [id])
  usuarios           UsuarioNegocio[]
  categorias         Categoria[]
  productos          Producto[]
  movimientos        MovimientoInventario[]
  auditorias         Auditoria[]
  clientes           Cliente[]
  cajas              Caja[]
  ventas             Venta[]
  detallesVenta      DetalleVenta[]
  pagosVenta         PagoVenta[]
  devoluciones       Devolucion[]
  detallesDevolucion DetalleDevolucion[]

  @@index([empresaId])
}

model Usuario {
  id             String   @id @default(cuid())
  /// Vacío solo para el superadmin de EMY TELECOM.
  empresaId      String?
  /// Nombre con el que inicia sesión. Único en todo el sistema.
  usuario        String   @unique
  nombre         String
  hashContrasena String
  rol            Rol
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  empresa        Empresa?               @relation(fields: [empresaId], references: [id])
  negocios       UsuarioNegocio[]
  movimientos    MovimientoInventario[]
  auditorias     Auditoria[]
  ventas         Venta[]                @relation("VentaCajero")
  ventasAnuladas Venta[]                @relation("VentaAnulador")
  devoluciones   Devolucion[]
  cajasAbiertas  Caja[]                 @relation("CajaApertura")
  cajasCerradas  Caja[]                 @relation("CajaCierre")

  @@index([empresaId])
}

/// Negocios a los que tiene acceso un socio o cajero.
/// El administrador ve todos los negocios de su empresa sin asignación.
model UsuarioNegocio {
  empresaId String
  usuarioId String
  negocioId String

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  negocio Negocio @relation(fields: [negocioId], references: [id])

  @@id([usuarioId, negocioId])
  @@index([empresaId])
  @@index([negocioId])
}

// ─── Inventario (Fase 1) ────────────────────────────────────────────────────

enum UnidadMedida {
  UNIDAD
  METRO
  CENTIMETRO
  KILO
  GRAMO
  LIBRA
  LITRO
  GALON
}

enum CondicionProducto {
  NUEVO
  DE_SEGUNDA
}

enum TipoMovimiento {
  CREACION
  AJUSTE
  IMPORTACION
  COMPRA
  VENTA
  ANULACION
  DEVOLUCION
}

enum MotivoAjuste {
  CONTEO
  DANO
  PERDIDA
  OTRO
}

model Categoria {
  id             String   @id @default(cuid())
  empresaId      String
  negocioId      String
  nombre         String
  /// Margen sugerido de la categoría, en % sobre el costo. Vacío = usa el del negocio.
  margenSugerido Decimal? @db.Decimal(6, 2)
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  negocio   Negocio    @relation(fields: [negocioId], references: [id])
  productos Producto[]

  @@unique([negocioId, nombre])
  @@index([empresaId])
}

model Producto {
  id            String            @id @default(cuid())
  empresaId     String
  negocioId     String
  categoriaId   String?
  /// Código o referencia interna. Único dentro del negocio.
  codigo        String
  codigoBarras  String?
  nombre        String
  descripcion   String?
  /// Costo promedio ponderado, en pesos enteros.
  costo         Int               @default(0)
  /// Precio de venta al público (IVA incluido), en pesos enteros.
  precioVenta   Int
  /// Cantidades con hasta 3 decimales (2,5 m · 0,350 kg).
  stock         Decimal           @default(0) @db.Decimal(14, 3)
  stockMinimo   Decimal           @default(0) @db.Decimal(14, 3)
  unidad        UnidadMedida      @default(UNIDAD)
  /// Si se puede vender en cantidades con decimales.
  fraccionado   Boolean           @default(false)
  /// Porcentaje de IVA: 0, 5 o 19.
  porcentajeIva Int               @default(0)
  condicion     CondicionProducto @default(NUEVO)
  activo        Boolean           @default(true)
  creadoEn      DateTime          @default(now())
  actualizadoEn DateTime          @updatedAt

  empresa            Empresa                @relation(fields: [empresaId], references: [id])
  negocio            Negocio                @relation(fields: [negocioId], references: [id])
  categoria          Categoria?             @relation(fields: [categoriaId], references: [id])
  movimientos        MovimientoInventario[]
  detallesVenta      DetalleVenta[]
  detallesDevolucion DetalleDevolucion[]

  @@unique([negocioId, codigo])
  @@unique([negocioId, codigoBarras])
  @@index([empresaId])
  @@index([negocioId, nombre])
  @@index([categoriaId])
  // Búsqueda rápida por partes del nombre o del código ("tornillo 1/4").
  @@index([nombre(ops: raw("gin_trgm_ops"))], type: Gin, map: "Producto_nombre_trgm_idx")
  @@index([codigo(ops: raw("gin_trgm_ops"))], type: Gin, map: "Producto_codigo_trgm_idx")
}

/// Toda entrada o salida de stock. El stock de un producto es la suma de sus movimientos.
model MovimientoInventario {
  id           String         @id @default(cuid())
  empresaId    String
  negocioId    String
  productoId   String
  usuarioId    String
  tipo         TipoMovimiento
  motivo       MotivoAjuste?
  nota         String?
  /// Positiva si entra, negativa si sale.
  cantidad     Decimal        @db.Decimal(14, 3)
  stockAntes   Decimal        @db.Decimal(14, 3)
  stockDespues Decimal        @db.Decimal(14, 3)
  creadoEn     DateTime       @default(now())

  empresa  Empresa  @relation(fields: [empresaId], references: [id])
  negocio  Negocio  @relation(fields: [negocioId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([productoId, creadoEn])
  @@index([negocioId, creadoEn])
  @@index([empresaId])
}

/// Quién hizo qué y cuándo en acciones sensibles.
model Auditoria {
  id        String   @id @default(cuid())
  empresaId String
  negocioId String?
  usuarioId String
  /// AJUSTE_STOCK, CAMBIO_PRECIO, IMPORTACION, ANULACION_VENTA, CAMBIO_PERMISOS…
  accion    String
  entidad   String
  entidadId String?
  detalle   Json
  creadoEn  DateTime @default(now())

  empresa Empresa  @relation(fields: [empresaId], references: [id])
  negocio Negocio? @relation(fields: [negocioId], references: [id])
  usuario Usuario  @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, creadoEn])
  @@index([negocioId, creadoEn])
}

// ─── Ventas (Fase 2) ────────────────────────────────────────────────────────

enum EstadoVenta {
  REGISTRADA
  ANULADA
  CON_DEVOLUCION
}

/// Medios de pago. Para agregar tarjeta basta con sumar un valor aquí.
enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
}

enum TipoDocumento {
  CC
  NIT
  CE
  PASAPORTE
  TI
  OTRO
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

/// Cliente opcional de la venta. Es de cada negocio: no se comparte entre locales.
model Cliente {
  id              String         @id @default(cuid())
  empresaId       String
  negocioId       String
  tipoDocumento   TipoDocumento?
  numeroDocumento String?
  nombre          String
  telefono        String?
  correo          String?
  direccion       String?
  activo          Boolean        @default(true)
  creadoEn        DateTime       @default(now())
  actualizadoEn   DateTime       @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  negocio Negocio @relation(fields: [negocioId], references: [id])
  ventas  Venta[]

  @@unique([negocioId, tipoDocumento, numeroDocumento])
  @@index([empresaId])
  @@index([negocioId, nombre])
}

/// Caja del día de un negocio: base al abrir y conteo al cerrar.
model Caja {
  id           String     @id @default(cuid())
  empresaId    String
  negocioId    String
  /// Día de la caja, en hora de Bogotá.
  fecha        DateTime   @db.Date
  estado       EstadoCaja @default(ABIERTA)
  base         Int
  abiertaPorId String
  abiertaEn    DateTime   @default(now())
  cerradaPorId String?
  cerradaEn    DateTime?
  /// Efectivo que debería haber al cerrar: base + ventas en efectivo − salidas de efectivo.
  esperado     Int?
  contado      Int?
  diferencia   Int?
  nota         String?

  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  negocio      Negocio      @relation(fields: [negocioId], references: [id])
  abiertaPor   Usuario      @relation("CajaApertura", fields: [abiertaPorId], references: [id])
  cerradaPor   Usuario?     @relation("CajaCierre", fields: [cerradaPorId], references: [id])
  ventas       Venta[]      @relation("VentaCaja")
  anulaciones  Venta[]      @relation("VentaCajaAnulacion")
  devoluciones Devolucion[]

  @@unique([negocioId, fecha])
  @@index([empresaId])
}

/// Una venta registrada no se edita ni se borra: se anula o se le hace una devolución.
model Venta {
  id              String      @id @default(cuid())
  empresaId       String
  negocioId       String
  cajaId          String
  usuarioId       String
  clienteId       String?
  /// Consecutivo del negocio, sin huecos ni repeticiones.
  consecutivo     Int
  /// Suma de cantidad × precio, antes de descuentos.
  subtotal        Int
  descuento       Int
  base            Int
  iva             Int
  total           Int
  /// Efectivo que entregó el cliente y cambio que se le dio.
  recibido        Int?
  cambio          Int?
  estado          EstadoVenta @default(REGISTRADA)
  anuladaEn       DateTime?
  anuladaPorId    String?
  anuladaEnCajaId String?
  motivoAnulacion String?
  creadoEn        DateTime    @default(now())
  // Reservado para facturación electrónica (DIAN). Vacío por ahora.
  feEstado        String?
  feIdentificador String?
  feRespuesta     Json?

  empresa       Empresa        @relation(fields: [empresaId], references: [id])
  negocio       Negocio        @relation(fields: [negocioId], references: [id])
  caja          Caja           @relation("VentaCaja", fields: [cajaId], references: [id])
  usuario       Usuario        @relation("VentaCajero", fields: [usuarioId], references: [id])
  cliente       Cliente?       @relation(fields: [clienteId], references: [id])
  anuladaPor    Usuario?       @relation("VentaAnulador", fields: [anuladaPorId], references: [id])
  anuladaEnCaja Caja?          @relation("VentaCajaAnulacion", fields: [anuladaEnCajaId], references: [id])
  detalles      DetalleVenta[]
  pagos         PagoVenta[]
  devoluciones  Devolucion[]

  @@unique([negocioId, consecutivo])
  @@index([empresaId])
  @@index([negocioId, creadoEn])
  @@index([cajaId])
}

/// Línea de la venta. Guarda nombre, precio y costo del momento de la venta.
model DetalleVenta {
  id               String       @id @default(cuid())
  empresaId        String
  negocioId        String
  ventaId          String
  productoId       String
  codigo           String
  nombre           String
  unidad           UnidadMedida
  cantidad         Decimal      @db.Decimal(14, 3)
  cantidadDevuelta Decimal      @default(0) @db.Decimal(14, 3)
  precioUnitario   Int
  costoUnitario    Int
  porcentajeIva    Int
  /// cantidad × precio, antes de descuentos.
  subtotal         Int
  /// Descuento de la línea más su parte del descuento general.
  descuento        Int
  base             Int
  iva              Int
  total            Int

  empresa   Empresa             @relation(fields: [empresaId], references: [id])
  negocio   Negocio             @relation(fields: [negocioId], references: [id])
  venta     Venta               @relation(fields: [ventaId], references: [id])
  producto  Producto            @relation(fields: [productoId], references: [id])
  devueltos DetalleDevolucion[]

  @@index([ventaId])
  @@index([productoId])
  @@index([empresaId])
}

model PagoVenta {
  id         String    @id @default(cuid())
  empresaId  String
  negocioId  String
  ventaId    String
  medio      MedioPago
  valor      Int
  referencia String?

  empresa Empresa @relation(fields: [empresaId], references: [id])
  negocio Negocio @relation(fields: [negocioId], references: [id])
  venta   Venta   @relation(fields: [ventaId], references: [id])

  @@index([ventaId])
  @@index([empresaId])
}

/// Devolución parcial o total: documento aparte ligado a la venta.
model Devolucion {
  id          String    @id @default(cuid())
  empresaId   String
  negocioId   String
  ventaId     String
  cajaId      String
  usuarioId   String
  consecutivo Int
  motivo      String
  /// Por dónde sale el dinero que se le devuelve al cliente.
  medio       MedioPago
  base        Int
  iva         Int
  total       Int
  creadoEn    DateTime  @default(now())

  empresa  Empresa             @relation(fields: [empresaId], references: [id])
  negocio  Negocio             @relation(fields: [negocioId], references: [id])
  venta    Venta               @relation(fields: [ventaId], references: [id])
  caja     Caja                @relation(fields: [cajaId], references: [id])
  usuario  Usuario             @relation(fields: [usuarioId], references: [id])
  detalles DetalleDevolucion[]

  @@unique([negocioId, consecutivo])
  @@index([ventaId])
  @@index([cajaId])
  @@index([empresaId])
}

model DetalleDevolucion {
  id             String  @id @default(cuid())
  empresaId      String
  negocioId      String
  devolucionId   String
  detalleVentaId String
  productoId     String
  cantidad       Decimal @db.Decimal(14, 3)
  base           Int
  iva            Int
  total          Int

  empresa      Empresa      @relation(fields: [empresaId], references: [id])
  negocio      Negocio      @relation(fields: [negocioId], references: [id])
  devolucion   Devolucion   @relation(fields: [devolucionId], references: [id])
  detalleVenta DetalleVenta @relation(fields: [detalleVentaId], references: [id])
  producto     Producto     @relation(fields: [productoId], references: [id])

  @@index([devolucionId])
  @@index([empresaId])
}
