# Copia este archivo como .env y cambia los valores.

# Base de datos principal (la de docker-compose.yml por defecto)
DATABASE_URL="postgresql://control:control@localhost:5432/control_total"

# Base de datos para las pruebas automáticas (se borra en cada corrida)
DATABASE_URL_TEST="postgresql://control:control@localhost:5432/control_total_test"

# Clave secreta para firmar las sesiones. Genera una con: npx auth secret
AUTH_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria"

# Necesario fuera de Vercel (Railway, DigitalOcean, local)
AUTH_TRUST_HOST=true

# Contraseña que tendrán los usuarios de prueba creados por el seed
SEED_CONTRASENA="cambia-esta-clave"
